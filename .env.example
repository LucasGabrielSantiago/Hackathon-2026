# Variáveis do docker compose (copie para .env — o .env NUNCA vai para o Git)
# Gere um segredo forte, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Origens permitidas no CORS (separe várias por vírgula)
FRONTEND_URL=http://localhost:8080
VITE_API_URL=http://localhost:3001/api
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
CATADOR_CENTAVOS_POR_KG=80
