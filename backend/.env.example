PORT=3001
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=8h
# Origens do front-end permitidas no CORS (separe várias por vírgula)
FRONTEND_URL=http://localhost:5173
# IA de classificação (opcional: sem chave, usa o classificador de reserva por texto)
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
# Remuneração do catador por kg coletado, em centavos (independente da recompensa do morador)
CATADOR_CENTAVOS_POR_KG=80
# Recuperação de senha sem e-mail (MVP): mostra o link na tela. Ligado fora de produção; em produção só com true.
RECUPERACAO_LINK_DEMO=
# Persistência (opcional): PostgreSQL. Vazio = dados só em memória (somem ao reiniciar).
# Ex. local com Docker: postgresql://postgres:postgres@localhost:5432/reciclape
DATABASE_URL=
